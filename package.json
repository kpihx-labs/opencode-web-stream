{
  "name": "opencode-web-stream",
  "version": "1.0.0",
  "description": "Sovereign live voice companion for OpenCode Web: duplex narration, barge-in, voice control, phonetic lexicon. Daemon + Lens cockpit plugin.",
  "keywords": [
    "opencode",
    "opencode-lens",
    "opencode-web",
    "voice",
    "live",
    "barge-in",
    "streamer"
  ],
  "license": "MIT",
  "author": "KπX",
  "type": "module",
  "exports": {
    ".": "./lens.plugin.json",
    "./plugin": "./dist/plugin.js",
    "./daemon": "./dist/daemon/index.js"
  },
  "bin": {
    "opencode-web-stream": "./dist/daemon/index.js"
  },
  "scripts": {
    "build": "npm run clean && npm run build:daemon && npm run build:browser",
    "build:daemon": "tsc -p tsconfig.json",
    "build:browser": "node scripts/build-browser.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json",
    "test": "npm run build && node --test --test-concurrency=1 'tests/**/*.test.mjs'",
    "test:unit": "npm run build:daemon && node --test 'tests/unit/*.test.mjs'",
    "start": "node dist/daemon/index.js",
    "dev": "npm run build && node dist/daemon/index.js"
  },
  "dependencies": {
    "marked": "^18.0.13",
    "pino": "^10.3.1",
    "talisman": "^1.1.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "0.28.2",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
